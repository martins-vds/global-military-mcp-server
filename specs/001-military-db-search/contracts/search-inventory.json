{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "search-inventory",
    "title": "search_inventory",
    "description": "Search military inventory data (air forces, air bases, navies, ranks, nuclear arsenals) on GlobalMilitary.net. Returns country-level force composition and strategic data with pagination.",
    "type": "object",
    "properties": {
        "tool": {
            "const": "search_inventory"
        },
        "annotations": {
            "type": "object",
            "properties": {
                "readOnlyHint": {
                    "const": true
                },
                "idempotentHint": {
                    "const": true
                },
                "openWorldHint": {
                    "const": true
                }
            }
        },
        "inputSchema": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string",
                    "enum": [
                        "air_forces",
                        "air_bases",
                        "navies",
                        "ranks",
                        "nuclear"
                    ],
                    "description": "Inventory category to search within. Required."
                },
                "query": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Name or keyword search text. Availability varies by category — navies has no search. Optional.",
                    "default": null
                },
                "country": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ISO 3166-1 alpha-3 country code to filter by (e.g., 'usa', 'ind'). Optional.",
                    "pattern": "^[a-zA-Z]{3}$",
                    "default": null
                },
                "page": {
                    "type": "integer",
                    "description": "Page number for pagination (1-indexed). Navies has no pagination (all data on one page). Default: 1.",
                    "minimum": 1,
                    "default": 1
                }
            },
            "required": [
                "category"
            ],
            "additionalProperties": false
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "description": "List of matching inventory items. Shape varies by category (see sub-schemas below).",
                    "items": {
                        "oneOf": [
                            {
                                "title": "Navy",
                                "type": "object",
                                "properties": {
                                    "country": {
                                        "$ref": "#/$defs/Country"
                                    },
                                    "rank": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "navy_index": {
                                        "type": "number"
                                    },
                                    "capital_ships": {
                                        "type": "integer",
                                        "minimum": 0
                                    },
                                    "major_combatants": {
                                        "type": "integer",
                                        "minimum": 0
                                    },
                                    "total_active": {
                                        "type": "integer",
                                        "minimum": 0
                                    },
                                    "detail_url": {
                                        "type": "string",
                                        "format": "uri-reference"
                                    }
                                },
                                "required": [
                                    "country",
                                    "rank",
                                    "navy_index",
                                    "capital_ships",
                                    "major_combatants",
                                    "total_active",
                                    "detail_url"
                                ]
                            },
                            {
                                "title": "AirBase",
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "operating_country": {
                                        "$ref": "#/$defs/Country"
                                    },
                                    "host_country": {
                                        "$ref": "#/$defs/Country"
                                    },
                                    "year_established": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "name",
                                    "operating_country",
                                    "host_country"
                                ]
                            },
                            {
                                "title": "NuclearArsenal",
                                "type": "object",
                                "properties": {
                                    "country": {
                                        "$ref": "#/$defs/Country"
                                    },
                                    "total_warheads": {
                                        "type": "integer",
                                        "minimum": 0
                                    },
                                    "deployed": {
                                        "type": "integer",
                                        "minimum": 0
                                    },
                                    "stockpile": {
                                        "type": "integer",
                                        "minimum": 0
                                    },
                                    "retired": {
                                        "type": "integer",
                                        "minimum": 0
                                    }
                                },
                                "required": [
                                    "country",
                                    "total_warheads",
                                    "deployed",
                                    "stockpile",
                                    "retired"
                                ]
                            },
                            {
                                "title": "RankStructure",
                                "type": "object",
                                "properties": {
                                    "country": {
                                        "$ref": "#/$defs/Country"
                                    },
                                    "branch": {
                                        "type": "string"
                                    },
                                    "ranks": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "type": "string"
                                                },
                                                "nato_code": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "grade": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "name",
                                                "grade"
                                            ]
                                        }
                                    }
                                },
                                "required": [
                                    "country",
                                    "branch",
                                    "ranks"
                                ]
                            },
                            {
                                "title": "AirForce",
                                "type": "object",
                                "properties": {
                                    "country": {
                                        "$ref": "#/$defs/Country"
                                    },
                                    "rank": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "air_force_index": {
                                        "type": "number"
                                    },
                                    "total_aircraft": {
                                        "type": "integer",
                                        "minimum": 0
                                    },
                                    "detail_url": {
                                        "type": "string",
                                        "format": "uri-reference"
                                    }
                                },
                                "required": [
                                    "country",
                                    "rank",
                                    "air_force_index",
                                    "total_aircraft",
                                    "detail_url"
                                ]
                            }
                        ]
                    }
                },
                "total_count": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Estimated total matching items across all pages."
                },
                "page_info": {
                    "type": "object",
                    "properties": {
                        "current_page": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "total_pages": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "has_next": {
                            "type": "boolean"
                        },
                        "has_previous": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "current_page",
                        "total_pages",
                        "has_next",
                        "has_previous"
                    ]
                },
                "query_notes": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Human-readable notes about the query interpretation."
                },
                "category": {
                    "type": "string",
                    "description": "The inventory category that was searched."
                },
                "filters_applied": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Map of active filter names to values."
                }
            },
            "required": [
                "items",
                "total_count",
                "page_info",
                "category",
                "filters_applied"
            ]
        }
    },
    "$defs": {
        "Country": {
            "type": "object",
            "properties": {
                "iso3": {
                    "type": "string",
                    "pattern": "^[a-z]{3}$"
                },
                "name": {
                    "type": "string"
                },
                "flag_emoji": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "iso3",
                "name"
            ]
        }
    },
    "examples": [
        {
            "description": "Top 5 navies",
            "input": {
                "category": "navies"
            },
            "expectedOutput": {
                "items": [
                    {
                        "country": {
                            "iso3": "usa",
                            "name": "United States",
                            "flag_emoji": "🇺🇸"
                        },
                        "rank": 1,
                        "navy_index": 323.8,
                        "capital_ships": 24,
                        "major_combatants": 113,
                        "total_active": 490,
                        "detail_url": "/navies/usa/"
                    }
                ],
                "total_count": 45,
                "page_info": {
                    "current_page": 1,
                    "total_pages": 1,
                    "has_next": false,
                    "has_previous": false
                },
                "query_notes": "Navies listing: all results on single page (no pagination for navies).",
                "category": "navies",
                "filters_applied": {}
            }
        },
        {
            "description": "Nuclear arsenals",
            "input": {
                "category": "nuclear"
            },
            "expectedOutput": {
                "items": [
                    {
                        "country": {
                            "iso3": "usa",
                            "name": "United States",
                            "flag_emoji": "🇺🇸"
                        },
                        "total_warheads": 5550,
                        "deployed": 1744,
                        "stockpile": 2000,
                        "retired": 1806
                    }
                ],
                "total_count": 9,
                "page_info": {
                    "current_page": 1,
                    "total_pages": 1,
                    "has_next": false,
                    "has_previous": false
                },
                "query_notes": "Nuclear arsenal data for all 9 nuclear-armed states.",
                "category": "nuclear",
                "filters_applied": {}
            }
        }
    ],
    "errorCases": [
        {
            "condition": "Invalid inventory category",
            "error": "ToolError: Invalid inventory category 'army'. Valid categories: air_forces, air_bases, navies, ranks, nuclear"
        },
        {
            "condition": "Search query on navies (unsupported)",
            "error": "ToolError: Name search is not available for navies. Use country filter instead."
        },
        {
            "condition": "Upstream site unreachable",
            "error": "ToolError: Unable to reach GlobalMilitary.net. The data source is temporarily unavailable. Please try again later."
        }
    ]
}